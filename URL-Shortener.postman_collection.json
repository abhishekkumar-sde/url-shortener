{
  "info": {
    "_postman_id": "9d2b7a41-4c53-4a8a-bb77-urlshortener",
    "name": "URL-Shortener",
    "description": "Postman collection for the Go URL Shortener API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:10002"
    },
    {
      "key": "short_code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ping",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ping"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Create URL",
      "item": [
        {
          "name": "Create Short URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.expect(body.code).to.be.a('string').and.not.empty;",
                  "pm.expect(body.short_url).to.be.a('string').and.not.empty;",
                  "",
                  "pm.collectionVariables.set('short_code', body.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.google.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/urls",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "urls"
              ]
            }
          }
        },
        {
          "name": "Create Short URL with Expiry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.expect(body.code).to.be.a('string').and.not.empty;",
                  "pm.expect(body.expires_at).to.be.a('number');",
                  "",
                  "pm.collectionVariables.set('short_code', body.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.google.com\",\n  \"expires_in\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/urls",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "urls"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Resolve URL",
      "item": [
        {
          "name": "Resolve Short URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/{{short_code}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{short_code}}"
              ]
            }
          }
        },
        {
          "name": "Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/doesnotexist",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "doesnotexist"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
