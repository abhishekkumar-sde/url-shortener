{
  "info": {
    "_postman_id": "url-shortener-collection",
    "name": "URL-Shortener",
    "description": "Postman collection for the Go URL Shortener API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:10002"
    },
    {
      "key": "short_code",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Ping",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/ping"
      }
    },
    {
      "name": "Create Short URL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://www.google.com\"\n}"
        },
        "url": "{{base_url}}/api/v1/urls"
      }
    },
    {
      "name": "Create Short URL with Expiry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://www.linkedin.com/in/abhishekkumar-sde/\",\n  \"expires_in\": 60\n}"
        },
        "url": "{{base_url}}/api/v1/urls"
      }
    },
    {
      "name": "Resolve Short URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/{{short_code}}"
      }
    },
    {
      "name": "Invalid URL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"not-a-url\"\n}"
        },
        "url": "{{base_url}}/api/v1/urls"
      }
    },
    {
      "name": "Not Found",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/doesnotexist"
      }
    }
  ]
}
